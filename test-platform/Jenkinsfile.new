// ============================================================================
// Jenkinsfile.new — 从 0 重建(学习用)
// Lesson 0:  最小骨架
// Lesson 1a: Test stage(天真版 — 预期失败:mvn not found)
// Lesson 1b: Test stage(docker run 共享 workspace — 填 2 个空)
// ============================================================================

pipeline {
    agent any

    stages {
        stage('hello') {
            steps {
                echo 'hello'
            }
        }
        stage('Test') {
            steps {
                sh '''
                    docker run --rm \
                        --volumes-from "${HOSTNAME}" \
                        -w "$WORKSPACE/test-platform" \
                        maven:3.9-eclipse-temurin-17 \
                        mvn test -f backend/pom.xml
                '''
            }
        }
    }
}
