# MySQL root 密码
DB_PASSWORD=your_password_here

# JWT 签名密钥（必须 ≥32 字符；docker-compose.yml 生产部署必填，缺失会拒绝启动/部署）
JWT_SECRET=change_me_32_chars_minimum

# CI_TOKEN
CI_API_KEY=change_me_32_chars_minimum


# AI 服务（可选，不设则 AI 功能不可用）
AGNES_API_KEY=

# CORS 允许的前端来源(逗号分割,生产环境必填)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:81,http://localhost:82